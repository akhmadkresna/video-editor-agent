{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-editor/mockup.schema.json",
  "title": "edit/mockup.json — drawn-screen scenes (style: mockup)",
  "description": "Authored in CAM SOURCE seconds. `ae cover` remaps scene fromSec/toSec to output time and every inner atSec to scene-local. Not enforced by jsonschema at runtime — `ae mockup-suggest --apply` runs an equivalent hand-rolled check (agentic_editor/cover/mockup.py:validate_mockup).",
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "_meta": { "type": "object" }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "fromSec", "toSec", "layers"],
      "properties": {
        "id": { "type": "string" },
        "fromSec": { "type": "number", "minimum": 0, "description": "cam source seconds" },
        "toSec": { "type": "number", "minimum": 0, "description": "cam source seconds" },
        "in": { "type": "number", "description": "dissolve-in seconds (default 0.35)" },
        "out": { "type": "number" },
        "_beat": { "type": "string", "description": "source script beat (informational)" },
        "stage": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "chrome": { "enum": ["claude", "app", "browser", "none"] }
          }
        },
        "camera": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["atSec", "state"],
            "properties": {
              "atSec": { "type": "number", "description": "cam source seconds" },
              "state": { "enum": ["establish", "read", "focus"] },
              "focus": {
                "type": "string",
                "description": "region: chat.input | chat.caret | chat.turn.assistant | chat.turn.N | diff.before | diff.after | app.window | skills.row.<name> | skills.upload"
              },
              "focusPoint": {
                "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
              },
              "track": { "enum": ["caret", "cursor"] }
            }
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "description": "exactly one surface (ClaudeChat/DiffPanel/AppWindow/SkillsPanel), optionally a Cursor",
          "items": { "$ref": "#/$defs/layer" }
        }
      }
    },
    "layer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["component", "data"],
          "properties": {
            "component": { "const": "ClaudeChat" },
            "data": {
              "type": "object",
              "required": ["turns"],
              "properties": {
                "typeCps": { "type": "number" },
                "turns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["role", "text"],
                    "properties": {
                      "role": { "enum": ["user", "assistant"] },
                      "text": { "type": "string" },
                      "reveal": { "enum": ["instant", "type", "stream"] },
                      "atSec": { "type": "number" },
                      "skillBadge": { "type": "string" },
                      "attachments": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["name"],
                          "properties": { "name": { "type": "string" }, "kind": { "type": "string" } }
                        }
                      },
                      "toolBlock": {
                        "type": "object",
                        "required": ["lines"],
                        "properties": {
                          "label": { "type": "string" },
                          "lines": { "type": "array", "items": { "type": "string" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["component", "data"],
          "properties": {
            "component": { "const": "DiffPanel" },
            "data": {
              "type": "object",
              "required": ["before", "after"],
              "properties": {
                "before": { "type": "string" },
                "after": { "type": "string" },
                "atSec": { "type": "number" },
                "beforeMarks": { "$ref": "#/$defs/marks" },
                "afterMarks": { "$ref": "#/$defs/marks" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["component", "data"],
          "properties": {
            "component": { "const": "AppWindow" },
            "data": {
              "type": "object",
              "required": ["app"],
              "properties": {
                "app": { "enum": ["pptx", "xlsx", "docx", "preview", "browser"] },
                "content": { "enum": ["mock-deck", "mock-sheet", "mock-doc"] },
                "src": { "type": "string", "description": "staged ae-media path to a host export still" },
                "atSec": { "type": "number" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["component", "data"],
          "properties": {
            "component": { "const": "SkillsPanel" },
            "data": {
              "type": "object",
              "required": ["skills"],
              "properties": {
                "skills": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["name", "on"],
                    "properties": {
                      "name": { "type": "string" },
                      "source": { "type": "string" },
                      "on": { "type": "boolean" }
                    }
                  }
                },
                "action": { "type": "string", "description": "toggle:<name> | upload" },
                "atSec": { "type": "number" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["component", "data"],
          "properties": {
            "component": { "const": "RepoView" },
            "data": {
              "type": "object",
              "required": ["repoUrl", "markdown"],
              "properties": {
                "repoUrl": { "type": "string", "description": "resolved by ae mockup-suggest from skills.yaml" },
                "repo": { "type": "string" },
                "path": { "type": "string" },
                "source": { "type": "string", "description": "Anthropic | community" },
                "markdown": { "type": "string", "description": "real SKILL.md text, fetched + cached under edit/.mockup-cache/" },
                "scroll": { "type": "boolean" },
                "atSec": { "type": "number" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["component", "data"],
          "properties": {
            "component": { "const": "Cursor" },
            "data": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["atSec"],
                    "properties": {
                      "atSec": { "type": "number" },
                      "target": { "type": "string" },
                      "point": {
                        "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
                      },
                      "action": { "enum": ["move", "hover", "click"] },
                      "dwell": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "span"],
        "properties": {
          "type": { "enum": ["add", "del"] },
          "span": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
        }
      }
    }
  }
}
